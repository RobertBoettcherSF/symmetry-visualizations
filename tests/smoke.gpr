project Smoke is
   for Source_Dirs use ("../src", ".");
   for Object_Dir use "../obj/native";
   for Exec_Dir use "../obj/native";
   for Main use ("smoke.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnatwe", "-gnata", "-O2");
   end Compiler;
end Smoke;
